<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9EF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="#244E5A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Divina Providencia"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#244E5A"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escápate, descansa y disfruta"
            android:textSize="17sp"
            android:textColor="#4A5C50"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reserva alojamientos rurales, experiencias al aire libre y gastronomía local desde una app sencilla e intuitiva."
            android:textSize="15sp"
            android:textColor="#4A5C50"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btnReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reservar Ahora"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2FA59A"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnAlojamientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nuestros Alojamientos"
            android:textColor="#FFFFFF"
            android:backgroundTint="#244E5A"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnExperiencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vive la experiencia"
            android:textColor="#FFFFFF"
            android:backgroundTint="#244E5A"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación y Contacto"
            android:textColor="#244E5A"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>